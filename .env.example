# nooa-sns 환경변수 예시 — 복사해서 .env로 쓰고 값을 채운다. .env는 gitignore됨.
#   cp .env.example .env
# 실행(컨테이너, 권장): docker compose run --rm app uv run python -m sns.smoke
# nooa는 Linux 전용(fcntl)이라 Windows 네이티브 실행 불가 — README 참조.

# ── LLM (FR-C3) ─────────────────────────────────────────────────────
# 역할별 모델 오버라이드(LiteLLM 모델 ID). 미설정 시 기본값:
#   judgment=claude-sonnet-5 (ANTHROPIC_API_KEY 필요)
#   bulk=gemini/gemini-2.5-flash (GEMINI_API_KEY 필요)
# GPT 저비용 테스트(OPENAI_API_KEY만 필요): gpt-5.4-nano 권장.
# 절대 최저가 gpt-5-nano($0.05/M)는 2026-08-20 스모크에서 NOT GROUNDED
# (툴이 준 트렌드를 무시하고 지어냄) — CodeAct 최저 가용선은 gpt-5.4-nano($0.20/M).
SNS_LLM_JUDGMENT=gpt-5.4-nano
SNS_LLM_BULK=gpt-5.4-nano

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ── DB · 암호화 ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://sns:sns@localhost:5432/sns
# Fernet 키 발급: uv run python -c "from sns.crypto import generate_key; print(generate_key())"
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1

# ── 발행 어댑터 (사용하는 플랫폼만) ─────────────────────────────────
# IG_USER_ID=
# YT_CLIENT_SECRET=secrets/yt_client_secret.json
# YT_TOKEN=secrets/yt_token.json

# ── 알림·트렌드 소스 (선택) ─────────────────────────────────────────
# DISCORD_WEBHOOK_URL=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# YOUTUBE_API_KEY=

# ── 샌드박스 게이트 (FR-S1) — 컨테이너 이미지가 선언, 로컬 .env엔 두지 말 것 ──
# SNS_SANDBOX=1
