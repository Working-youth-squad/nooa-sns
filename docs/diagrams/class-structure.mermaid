%% NOOA 클래스 분기 초안 — FR-C1·C2·C6·C8, FR-S3 대응
%% 분할 기준 = "능력·권한 경계"(ERD의 정규화 기준과 다름):
%%   에이전트 클래스 표면(self에 보이는 것) = CodeAct가 할 수 있는 전부.
%%   메서드명 뒤 * = NOOA 생성 메서드(본문 `...`, docstring=프롬프트, 반환 타입=Pydantic 계약).
%%   시크릿·raw DB는 어떤 에이전트 클래스에도 없음 — 툴 구현 내부에만(FR-S3).
classDiagram
    direction TB

    class OrchestratorAgent {
        <<CodeAct·완전 자율 계획>>
        +topic : TopicAgent
        +content : ContentAgent
        +media : MediaAgent
        +publisher : PublisherAgent
        +analyst : AnalystAgent
        +growth : GrowthAgent
        +run_cycle(goal_ref)* CyclePlanResult
    }
    note for OrchestratorAgent "슬롯 트리거만 입력.\n순서·병렬(asyncio.gather)·스킵·재시도를\nCodeAct가 계획 (FR-C6).\n위임 예산·max_iterations 상한 (FR-O3)"

    class TopicAgent {
        <<CodeAct>>
        +research_trends : ResearchTrends
        +read_stats : ReadStats
        +pick_topic(playbook)* TopicChoice
    }
    class ContentAgent {
        <<CodeAct>>
        +write_content(topic, format, playbook)* ContentDraft
    }
    note for ContentAgent "착지점 1/3: content_item.body\n+ media_spec (툴 경유 저장)"
    class MediaAgent {
        <<CodeAct>>
        +render_media : RenderMedia
        +produce(media_spec)* MediaPlan
    }
    class PublisherAgent {
        <<CodeAct>>
        +publish : Publish
        +publish_approved(publication)* PublishReport
    }
    class AnalystAgent {
        <<CodeAct>>
        +poll_metrics : PollMetrics
        +read_stats : ReadStats
        +write_playbook : WritePlaybook
        +analyze(cycle)* AnalysisDraft
    }
    note for AnalystAgent "착지점 2/3, 3/3:\nplaybook.guidance · analysis_note.body\n(정직 귀인, 수치는 코드만)"
    class GrowthAgent {
        <<CodeAct>>
        +read_stats : ReadStats
        +choose_variant(stats)* CycleDecision
    }

    OrchestratorAgent o-- TopicAgent
    OrchestratorAgent o-- ContentAgent
    OrchestratorAgent o-- MediaAgent
    OrchestratorAgent o-- PublisherAgent
    OrchestratorAgent o-- AnalystAgent
    OrchestratorAgent o-- GrowthAgent

    class NooaAdapter {
        <<어댑터 계층 FR-C8 — nooa import 유일 지점>>
        +Agent 베이스 재수출
        +CodeActStrategy 구성(max_iterations)
        +get_llm_client 별칭(판단=claude-sonnet-5 / 대량=gemini-flash)
        +FakeUnifiedLLM 주입 시임(NFR-1)
        +이벤트→run_event 브리지(FR-C5)
    }
    OrchestratorAgent ..> NooaAdapter : 상속 원천

    class ResearchTrends {
        <<Protocol contracts.py:42>>
        +__call__(sources, limit) TrendDigest
    }
    class RenderMedia {
        <<Protocol contracts.py:56>>
        +__call__(media_spec, kind) MediaAsset
    }
    class Publish {
        <<Protocol contracts.py:70>>
        +__call__(publication) PublishResult
    }
    class PollMetrics {
        <<Protocol contracts.py:95>>
        +__call__(publication, window) MetricValue
    }
    class ReadStats {
        <<Protocol contracts.py:113>>
        +__call__(platform) TopicStat
    }
    class WritePlaybook {
        <<Protocol contracts.py:127>>
        +__call__(scope, guidance) PlaybookVersion
    }

    class PublishToolImpl {
        <<툴 구현 — 불변식 소유>>
        -state_machine : 멱등 NFR-2
        -crypto : 토큰 복호화 FR-S3
        -official_api : IG Graph·YouTube v3
    }
    PublishToolImpl ..|> Publish : 구현

    TopicAgent ..> ResearchTrends
    TopicAgent ..> ReadStats
    MediaAgent ..> RenderMedia
    PublisherAgent ..> Publish
    AnalystAgent ..> PollMetrics
    AnalystAgent ..> WritePlaybook
    GrowthAgent ..> ReadStats

    note for PublishToolImpl "불변식은 여기(코드)에 산다.\n에이전트 재량과 무관하게\n이중 발행 0·시크릿 비노출 보장"
